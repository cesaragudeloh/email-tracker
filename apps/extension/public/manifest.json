{
  "manifest_version": 3,
  "name": "Email Tracker",
  "version": "0.0.0",
  "description": "Email Tracker con activaci\u00f3n por licencia para Chrome y Edge.",
  "action": {
    "default_title": "Email Tracker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.office.com/*",
        "https://outlook.live.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"]
}
