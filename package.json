{
  "name": "email-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo para una extensión de seguimiento de correos electrónicos.",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "packages/shared",
    "apps/extension",
    "services/tracking-api",
    "infrastructure/cdk"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  }
}
